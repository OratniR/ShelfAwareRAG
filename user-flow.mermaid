graph TD
    subgraph iPhone
        A[Siri] -- 「ねえSiri、鍵はどこ？」 --> B(Siriショートカット)
        B -- HTTP Request (JSON) --> E[FastAPI: /dispatch]
        E -- JSON Response --> B
        B -- 「鍵は青いボウルにあります。」 --> A
    end

    subgraph Raspberry Pi 5 (Static IP: 192.168.1.123)
        E -- "テキストをディスパッチ" --> F(Intent Router)
        
        F -- "Intent: 'query'" --> G(RAG Core: Query)
        G -- 1. Embed Query --> H(Embedding Model: multilingual-e5-small)
        G -- 2. Vector Search --> I(Vector DB: SQLite-vss)
        I -- "Context: [関連テキスト]" --> G
        G -- 3. Build Prompt --> J
        
        F -- "Intent: 'add'" --> K(RAG Core: Add)
        K -- 1. Embed Text --> H
        K -- 2. "INSERT INTO ..." --> I

        F -- "Intent: 'delete'" --> L(RAG Core: Delete)
        L -- 1. "DELETE FROM ..." --> I

        subgraph "LLM Server (llama-cpp-python)"
            J(Local LLM: open-calm-3b-gguf)
        end
        
        J -- 4. "Final Answer" --> G
        G -- "Response" --> E
        K -- "Response" --> E
        L -- "Response" --> E
    end